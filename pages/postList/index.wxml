<!--pages/postList/index.wxml-->
<topbar bgColor="bg-gradual-blue" isBack="{{true}}">
  <!-- <view slot="backText">Back</view> -->
  <view slot="content">{{siteInfo.name}}</view>
</topbar>
<view class="tab-content">
  <view class="list">
    <view class="list_label">
      <view class="list_label_title">{{title}}</view>
      <view class="list_label_bg"></view>
    </view>
    <view wx:if="{{loading == true && posts.length === 0}}" class="list_loading skeleton">
      <view class="skeleton-rect"></view>
      <view class="skeleton-rect"></view>
      <view class="skeleton-rect"></view>
    </view>
    <block wx:else>
      <view wx:if="{{posts.length > 0}}" class="list_post">
        <block wx:for="{{posts}}" wx:for-index="i" wx:key="item">
          <block wx:if="{{i%5 === 0}}">
            <view bindtap="bindDetail" class="list_post_box" id="{{item.id}}">
              <view class="list_post_figure">
                <image mode="aspectFill" class="list_post_cover"
                  src="{{item.meta.thumbnail || '/images/default_thumb.png'}}"></image>
                <view class="list_post_category">
                  <text>{{item.category[0].name}}</text>
                </view>
              </view>
              <view class="list_post_title">{{item.title.rendered}}</view>
              <view class="list_post_desc">{{item.excerpt.rendered}}</view>
            </view>
            <view wx:if="{{advert.type === 'unit'}}" class="advert">
              <ad unit-id="{{advert.code}}"></ad>
            </view>
          </block>
          <block wx:else>
            <view bindtap="bindDetail" class="list_post_box" id="{{item.id}}">
              <view class="list_post_figure">
                <image mode="aspectFill" class="list_post_cover"
                  src="{{item.meta.thumbnail || '/images/default_thumb.png'}}"></image>
                <view class="list_post_category">
                  <text>{{item.category[0].name}}</text>
                </view>
              </view>
              <view class="list_post_title">{{item.title.rendered}}</view>
              <view class="list_post_desc">{{item.excerpt.rendered}}</view>
            </view>
          </block>
        </block>
      </view>
      <view wx:if="{{isLastPage && posts.length === 0}}" class="list_post">
        <view class="list_post_null">
          <image mode="aspectFill" class="list_post_cover" src="../../images/message.png"></image>
        </view>
        <view class="last_text">对不起! 你查看的内容没有找到</view>
      </view>
      <view wx:if="{{isLastPage&&posts.length > 0}}" class="last_text">已经到底啦~</view>
      <view wx:if="{{!isLastPage&&posts.length > 0}}" class="last_text">努力加载中...</view>
    </block>
  </view>
</view>