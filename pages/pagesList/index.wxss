/* pages/pagesList/index.wxss */
.is-flex {
  display: flex;
}

.center-xs {
  justify-content: center;
  text-align: center;
}

.middle-xs {
  align-items: center;
}

.end-xs {
  justify-content: flex-end;
  text-align: end;
}

.direction-vert {
  flex-direction: column;
}

.section {
  padding: 40rpx;
  padding-bottom: 48rpx;
}

.section-features {
  height: 100%;
  min-height: 100vh;
}

.pages_label {
  position: relative;
  margin-bottom: 36rpx;
}

.pages_label_title {
  color: #fff;
  line-height: 58rpx;
  position: absolute;
  top: 0;
  left: 20rpx;
  z-index: 1;
}

.pages_label_bg {
  height: 58rpx;
  background: linear-gradient(270deg, rgba(249, 228, 135, 0) 0%, rgba(241, 197, 79, 1) 100%);
  border-radius: 11rpx;
}

.pages_loading.skeleton .skeleton-rect {
  height: 33vh;
  margin-top: 40rpx;
  background: #fff;
  border-radius: 15rpx;
}

.section-features .feature-list {
  width: 100%;
}

.section-features .feature-list .feature-card {
  position: relative;
  width: 100%;
  margin-bottom: 40rpx;
  font-weight: 300;
  font-size: 18px;
  flex: 1 0 auto;
  background: #fff;
  border-radius: 15rpx;
}

.section-features .feature-list .feature-card .card-cover {
  width: 100%;
  padding-top: 380rpx;
  max-width: 100%;
  background-size: cover;
  background-repeat: no-repeat;
  background-position: center;
  border-top-left-radius: 15rpx;
  border-top-right-radius: 15rpx;
}

.section-features .feature-list .feature-card .card-main {
  position: relative;
  padding: 0;
  text-align: left;
}

.section-features .feature-list .feature-card .card-main .card-top {
  padding: 30rpx 30rpx;
}

.section-features .feature-list .feature-card .card-title {
  line-height: 48rpx;
  font-weight: 400;
}

.section-features .feature-list .feature-card .card-content text {
  margin: 0;
  margin-bottom: 10px;
  font-size: 80%;
}

.section-features .feature-list .feature-card .card-main .card-actions {
  padding: 0 30rpx 30rpx;
}

.section-features .feature-list .feature-card .action-item {
  font-size: 30rpx;
}