<!--pages/userProfile/index.wxml-->
<topbar bgColor="bg-gradual-blue">
  <view slot="avatar" class="userProfile-headAvatar">
    <image wx:if="{{user == null || user == ''}}" src="/images/avatar-default.png" mode="widthFix"></image>
    <image wx:else src="{{user.avatarUrl || user.avatar}}" mode="widthFix"></image>
    <button class="login-button" bindtap="showLogin"></button>
  </view>
  <view slot="content">个人中心</view>
</topbar>
<view class="user-container" style="padding-top: {{navBarHeight}}px;">
  <view class="user-information relative" bindtap="showLogin">
    <view wx:if="{{user.avatarUrl || user.avatar}}" class="user-information_img" style="background-image: url('{{user.avatarUrl || user.avatar}}')">
    </view>
    <image wx:else class="user-information_img" src="../../images/avatar.png"></image>
    <view class="nickname">
      <view class="user-information_nickname">{{user.nickName ? user.nickName : (user.name ? user.name : '游客')}}</view>
      <view class="user-information_introduction">{{user ? 'Welcome!' : '点击登录'}}</view>
    </view>
  </view>
  <view class="user-items">
    <view class="user-item relative" data-type="userLike" bindtap="goUserList">
      <text class="user-item_text">我的点赞</text>
      <view class="user-item_icon">
        <image class="user-item_icon_img" src="../../images/my-inform.svg">
        </image>
        <view wx:if="{{unreadMessageCount > 0}}" class="user-item_icon_sup">
          {{unreadMessageCount}}
        </view>
      </view>
      <button class="userLogin"></button>
    </view>
    <view class="user-item relative" data-type="userFav" bindtap="goUserList">
      <text class="user-item_text">我的收藏</text>
      <view class="user-item_icon">
        <image class="user-item_icon_img" src="../../images/my-like.svg">
        </image>
      </view>
      <button class="userLogin"></button>
    </view>
    <view class="user-item relative" data-type="userComments" bindtap="goUserList">
      <text class="user-item_text">我的评论</text>
      <view class="user-item_icon">
        <image class="user-item_icon_img" src="../../images/my-dynamic.svg">
        </image>
      </view>
      <button class="userLogin"></button>
    </view>
    <!-- <view class="user-item relative">
      <text class="user-item_text">订阅更新</text>
      <view class="user-item_icon">
        <image class="user-item_icon_img" src="../../images/subscribe.png"></image>
      </view>
      <button class="userLogin"></button>
    </view> -->
    <!-- <view class="user-item">
      <text class="user-item_text">问题反馈</text>
      <view class="user-item_icon">
        <image class="user-item_icon_img" src="../../images/feedback.svg">
        </image>
      </view>
      <button class="userLogin"></button>
    </view> -->
    <!-- <view class="user-item">
      <text class="user-item_text">清除缓存</text>
      <view class="user-item_icon">
        <image class="user-item_icon_img"
          src="../../images/small-logo-gray-with-radius.svg"></image>
      </view>
      <button class="auth-btn" bindtap="loginOut"></button>
    </view> -->
  </view>
</view>

<!-- 登录弹框 -->
<view wx:if="{{showLogin}}" class="login-mask" bindtap="closeLogin">
  <view class="login-dialog" catchtap="noop">
    <view class="login-title">登录 Aine 账号</view>
    <view class="login-sub">使用 api.lyove.com 系统账号登录</view>
    <view class="login-input-wrap">
      <input class="login-input" placeholder="邮箱或用户名" placeholder-class="login-placeholder"
        value="{{loginAccount}}" bindinput="onLoginAccount" />
    </view>
    <view class="login-input-wrap">
      <input class="login-input" password placeholder="密码" placeholder-class="login-placeholder"
        value="{{loginPassword}}" bindinput="onLoginPassword" confirm-type="done" bindconfirm="submitLogin" />
    </view>
    <view class="login-btns">
      <view class="login-btn cancel" bindtap="closeLogin">取消</view>
      <view class="login-btn submit {{logining ? 'disabled' : ''}}" bindtap="submitLogin">{{logining ? '登录中...' : '登 录'}}</view>
    </view>
  </view>
</view>
