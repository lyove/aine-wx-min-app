.page {
  padding: 24rpx;
  background: #f5f6f7;
  min-height: 100vh;
  box-sizing: border-box;
}
.page-header {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 24rpx;
}
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
